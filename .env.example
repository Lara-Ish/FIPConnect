# Face++ Cognitive Services API Credentials (US Server)
FACEPLUSPLUS_API_KEY=your_faceplusplus_api_key_here
FACEPLUSPLUS_API_SECRET=your_faceplusplus_api_secret_here

# Biometric match confidence threshold percentage (e.g. 75.0%)
FACE_MATCH_THRESHOLD=75.0

# Optional test flag: Set to true to simulate API responses in offline/local testing
ENABLE_MOCK_VERIFICATION=false
